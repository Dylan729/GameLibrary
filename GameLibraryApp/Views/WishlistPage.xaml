<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GameLibraryApp.Views.WishlistPage"
    Title="Wishlist">

    <CollectionView 
        x:Name="WishlistCollectionView"
        ItemsLayout="VerticalList"
        Margin="10">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border 
                    Stroke="DarkRed"
                    StrokeThickness="2"
                    Padding="12"
                    Margin="8"
                    Background="{AppThemeBinding Light='#FFF', Dark='#222'}"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="4">
                        <Label 
                            Text="{Binding Title}"
                            FontAttributes="Bold"
                            FontSize="18" />

                        <Label 
                            Text="{Binding Genre}"
                            FontSize="14"
                            TextColor="{AppThemeBinding Light='Black', Dark='White'}" />
                    </VerticalStackLayout>

                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>
