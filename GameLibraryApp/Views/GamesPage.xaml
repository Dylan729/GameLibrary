<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GameLibraryApp.Views.GamesPage"
             Title="Games">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- Page Heading -->
        <Label Text="Game Library"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Search Bar -->
        <SearchBar x:Name="GameSearchBar"
                   Placeholder="Search games..."
                   TextChanged="OnSearchTextChanged" />

        <!-- Genre Picker -->
        <Picker x:Name="GenrePicker"
                Title="Select Genre"
                SelectedIndexChanged="OnGenreChanged">
            <Picker.Items>
                <x:String>All Genres</x:String>
                <x:String>Action</x:String>
                <x:String>Adventure</x:String>
                <x:String>Racing</x:String>
                <x:String>Sports</x:String>
                <x:String>Puzzle</x:String>
                <x:String>Strategy</x:String>
                <x:String>Simulation</x:String>
            </Picker.Items>
        </Picker>

        <!-- Result Count -->
        <Label x:Name="ResultCountLabel"
               FontAttributes="Bold"
               FontSize="16"
               Text="Results: 0" />

        <!-- CollectionView -->
        <CollectionView x:Name="GamesCollectionView"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="Gray"
                            StrokeThickness="1"
                            Padding="10"
                            Margin="10"
                            BackgroundColor="#f7f7f7"
                            StrokeShape="RoundRectangle 10">

                        <Grid ColumnDefinitions="120, *">

                            <!-- Game Image -->
                            <Image Grid.Column="0"
                                   HeightRequest="100"
                                   WidthRequest="100"
                                   Aspect="AspectFill"
                                   Source="{Binding ImageName}" />

                            <!-- Game Info -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Padding="10"
                                                 Spacing="5">

                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding Genre}" />
                                <Label Text="{Binding Platform}" />
                                <Label Text="Released: {Binding ReleaseYear}" />
                                <Label Text="Rating: {Binding Rating}" />

                                <!-- Buttons -->
                                <HorizontalStackLayout Spacing="10"
                                                       Margin="0,10,0,0">

                                    <Button Text="View Details"
                                            Clicked="OnViewDetailsClicked"
                                            CommandParameter="{Binding}" />

                                    <Button Text="Add to Wishlist"
                                            BackgroundColor="#cc0000"
                                            TextColor="White"
                                            Clicked="OnAddToWishlistClicked"
                                            CommandParameter="{Binding}" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
